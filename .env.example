# ─── Application ───────────────────────────────────────────────────────────
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO
LOG_JSON=true

# ─── LLM backend ───────────────────────────────────────────────────────────
# groq  -> hosted API (recommended for deployment)
# ollama-> local model (requires `pip install .[ollama]` and a running Ollama)
LLM_BACKEND=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=30

# ─── Embeddings / vector store ─────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_PERSIST_DIR=./data/chroma
COLLECTION_NAME=hindi_rag_v2

# ─── Retrieval ─────────────────────────────────────────────────────────────
RETRIEVAL_K=4
RETRIEVAL_FETCH_K=12
MMR_LAMBDA=0.5
CHUNK_SIZE=512
CHUNK_OVERLAP=64
CORPUS_DIR=./data/corpus

# ─── WhatsApp / Twilio ─────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Set to false only for local webhook testing without Twilio.
TWILIO_VALIDATE_SIGNATURE=true

# ─── Safety limits ─────────────────────────────────────────────────────────
MAX_QUESTION_CHARS=1000
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_S=60

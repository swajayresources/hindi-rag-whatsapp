# LLM Backend — "ollama" uses your local Qwen3-4B, "groq" uses Groq free API
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# Groq fallback (free at console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192

# Twilio WhatsApp (free sandbox at twilio.com/try-twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Retrieval
RETRIEVAL_K=4
CHUNK_SIZE=512
CHUNK_OVERLAP=64
